# ──────────────────────────────────────────────────────────
# Levina Chifie Portfolio — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real secrets.

# ── Vercel (required for CI deployment) ──────────────────
# VERCEL_TOKEN=       # Vercel API token (Settings → Tokens)
# VERCEL_ORG_ID=      # Vercel org ID (from .vercel/project.json)
# VERCEL_PROJECT_ID=  # Vercel project ID (from .vercel/project.json)
